diff --git a/src/mjlab_microduck/actuator/hobby_servo.py b/src/mjlab_microduck/actuator/hobby_servo.py
new file mode 100644
index 0000000..3793f49
--- /dev/null
+++ b/src/mjlab_microduck/actuator/hobby_servo.py
@@ -0,0 +1,110 @@
+"""A standard PWM hobby servo (MG996R / DS3218 / MG90S class), for milli's hobby tasks (duck-droids docs/HOBBY_SERVOS.md).
+
+What the real servo does, and how it is modelled here. Every number is a datasheet figure or an estimate to measure, never an identification:
+- one-way PWM: the controller sends a pulse width and reads nothing back. The pulse is a new target only once a frame (`frame_steps`
+  physics steps, 20 ms at 50 Hz), at a random phase per robot, on top of the delay buffer's lag (`delay_min_lag`..`delay_max_lag`);
+- the pulse is quantised (`quant_rad`: a PCA9685's 4096 counts over 20 ms is 4.9 us a count, about 0.45 deg on a 180 deg servo);
+- a calibration offset per unit (`offset_rad`): the horn's spline and the pot's zero never sit where the pulse says;
+- the servo's own analog/digital board: a deadband (`deadband_rad`), then a proportional drive that saturates at full duty once the
+  error passes `band_rad`. Its loop closes on the pot, which sits on the OUTPUT gear, so on the model it reads joint + backlash joint;
+- a DC motor behind it: torque = stall x (duty - speed / no-load speed), capped at +-stall. So it slows under load, the no-load speed is
+  its speed limit, and a held error of band x load/stall is the droop a P-only loop has under load;
+- backlash: a passive hinge in series with each servo joint (`passive_<joint>_backlash`, added by milli_hobby_env_cfg), free over
+  +-its range. The motor drives the servo joint; the link sits at their sum;
+- spread between units: gain (band), offset, speed, stall and deadband drawn per robot and per servo at every reset.
+"""
+from __future__ import annotations
+
+import dataclasses
+from dataclasses import dataclass
+
+import torch
+
+from mjlab.actuator.actuator import ActuatorCmd
+from mjlab.actuator.pd_actuator import IdealPdActuator, IdealPdActuatorCfg
+
+
+@dataclass(kw_only=True)
+class HobbyServoActuatorCfg(IdealPdActuatorCfg):
+    stall_nm: float
+    """Stall torque at the supply voltage, N m."""
+    noload_rads: float
+    """No-load speed at the supply voltage, rad/s (60 deg / the datasheet's s-per-60-deg)."""
+    band_rad: float = 0.10
+    """Error at which the drive reaches full duty (the board's proportional band). An estimate: measure the droop under a known load."""
+    deadband_rad: float = 0.005
+    """Error inside which the board does not drive: 0.3 deg. TowerPro lists 1 us for the MG996R and MG90S (0.1 deg at about 11 us a degree); Bittle's servos needed 1 deg in Jabbour et al. 2022, so the range below reaches that."""
+    quant_rad: float = 0.0077
+    """The PWM driver's step: 4.9 us (PCA9685 at 50 Hz) at about 11 us a degree."""
+    frame_steps: int = 4
+    """Physics steps a PWM frame (4 x 5 ms = 20 ms, 50 Hz)."""
+    offset_rad: float = 0.05
+    """Calibration error per unit, drawn from +-this."""
+    band_scale: tuple[float, float] = (0.6, 1.6)
+    speed_scale: tuple[float, float] = (0.8, 1.1)
+    stall_scale: tuple[float, float] = (0.8, 1.1)
+    deadband_scale: tuple[float, float] = (0.3, 3.5)
+    randomize: bool = True
+    stiffness: float = 0.0   # unused: the drive is band and stall, not a kp
+    damping: float = 0.0
+
+    def build(self, entity, target_ids, target_names) -> "HobbyServoActuator":
+        return HobbyServoActuator(self, entity, target_ids, target_names)
+
+
+class HobbyServoActuator(IdealPdActuator[HobbyServoActuatorCfg]):
+    def initialize(self, mj_model, model, data, device) -> None:
+        super().initialize(mj_model, model, data, device)
+        n, j = data.nworld, len(self._target_names)
+        c = self.cfg
+        full = lambda v: torch.full((n, j), float(v), device=device)
+        self.stall, self.noload, self.band, self.deadband = full(c.stall_nm), full(c.noload_rads), full(c.band_rad), full(c.deadband_rad)
+        self.offset = torch.zeros((n, j), device=device)
+        self.held = torch.zeros((n, j), device=device)          # the pulse the servo last received
+        self.phase = torch.randint(0, max(c.frame_steps, 1), (n, 1), device=device)
+        self.step_count = torch.zeros((n, 1), dtype=torch.long, device=device)
+        self.fresh = torch.ones((n, 1), dtype=torch.bool, device=device)
+        # the pot reads through the backlash: the passive hinge in series, where the model has one
+        names = {nm: i for i, nm in enumerate(self.entity.joint_names)}
+        ids = [names.get(f"passive_{t}_backlash", 0) for t in self._target_names]
+        self._bl_ids = torch.tensor(ids, dtype=torch.long, device=device)
+        self._bl_mask = torch.tensor([float(f"passive_{t}_backlash" in names) for t in self._target_names], device=device)
+        print(f"[HobbyServoActuator] {j} servos, stall {c.stall_nm} N m, {c.noload_rads} rad/s, backlash joints on {int(self._bl_mask.sum())}")
+        self.reset(None)
+
+    def reset(self, env_ids=None) -> None:
+        super().reset(env_ids)
+        if not hasattr(self, "stall"):
+            return
+        idx = slice(None) if env_ids is None else env_ids
+        rows = self.stall[idx].shape[0]
+        c, dev, j = self.cfg, self.stall.device, len(self._target_names)
+        u = lambda lo, hi: lo + (hi - lo) * torch.rand((rows, j), device=dev)
+        if c.randomize:
+            self.stall[idx] = c.stall_nm * u(*c.stall_scale)
+            self.noload[idx] = c.noload_rads * u(*c.speed_scale)
+            self.band[idx] = c.band_rad * u(*c.band_scale)
+            self.deadband[idx] = c.deadband_rad * u(*c.deadband_scale)
+            self.offset[idx] = c.offset_rad * u(-1.0, 1.0)
+        self.fresh[idx] = True
+        self.step_count[idx] = 0
+
+    def get_command(self, data) -> ActuatorCmd:
+        cmd = super().get_command(data)
+        return dataclasses.replace(cmd, pos=cmd.pos + data.joint_pos[:, self._bl_ids] * self._bl_mask)
+
+    def compute(self, cmd: ActuatorCmd) -> torch.Tensor:
+        c = self.cfg
+        target = cmd.position_target
+        if c.quant_rad > 0:
+            target = torch.round(target / c.quant_rad) * c.quant_rad
+        # a new pulse only at this robot's frame boundary (and at once after a reset)
+        new = self.fresh | ((self.step_count + self.phase) % max(c.frame_steps, 1) == 0)
+        self.held = torch.where(new, target, self.held)
+        self.fresh[:] = False
+        self.step_count += 1
+        err = self.held + self.offset - cmd.pos
+        err = torch.sign(err) * (err.abs() - self.deadband).clamp(min=0.0)
+        duty = (err / self.band).clamp(-1.0, 1.0)
+        tau = self.stall * (duty - cmd.vel / self.noload)
+        return torch.maximum(torch.minimum(tau, self.stall), -self.stall)
