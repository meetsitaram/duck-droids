diff --git a/src/mjlab_microduck/tasks/milli_hobby_env_cfg.py b/src/mjlab_microduck/tasks/milli_hobby_env_cfg.py
new file mode 100644
index 0000000..a28cfe1
--- /dev/null
+++ b/src/mjlab_microduck/tasks/milli_hobby_env_cfg.py
@@ -0,0 +1,224 @@
+"""milli on standard PWM hobby servos, and walking without joint feedback (duck-droids docs/HOBBY_SERVOS.md).
+
+The hybrid milli's body (32 cm; its STS3215-sized cases are about an MG996R's size and mass), with each servo replaced by a hobby servo
+(actuator/hobby_servo.py) and a backlash hinge in series. Four tasks, so each change can be judged alone against the walk it came from:
+
+  Mjlab-Velocity-Flat-Milli                bus servos, joint state in              (the existing task: the reference)
+  Mjlab-Velocity-Flat-Milli-Imu            bus servos, IMU + action history only   (what dropping joint state costs, alone)
+  Mjlab-Velocity-Flat-Milli-Hobby-Proprio  hobby servos, joint state in            (what the servo costs alone: a "feedback" servo with its pot wired to an ADC)
+  Mjlab-Velocity-Flat-Milli-Hobby-Imu      hobby servos, IMU + action history only (the cheap duck)
+  Mjlab-Velocity-Flat-Milli-Hobby-Blind    hobby servos, actions and clock only    (no IMU either: an open-loop baseline)
+  Mjlab-Velocity-Flat-Milli-Hobby-Fade     hobby servos, joint state faded out     (teacher to student: joint state in at first, gone by the end)
+
+-Fade (the user's idea, 2026-11-06): the actor keeps the -Proprio inputs, but each episode its joint position and velocity are zeroed with a
+probability that rises from 0 at FADE_FROM to 1 at FADE_TO iterations. It learns to walk with the joints' help, then leans on the IMU and its
+action history as the help goes away; from FADE_TO on it is an IMU-only policy, and on the robot those inputs are fed zeros. The critic sees
+the joints all the way through.
+
+The actor of the -Imu tasks sees: gyro, projected gravity (each with HISTORY steps), the velocity, head and body commands, its last HISTORY
+actions (the positions it commanded, which is all a PWM servo is told) and a gait clock. The critic keeps everything privileged: asymmetric
+actor-critic. All hobby tasks drop the foot switches, as the cheap duck wouldn't have them, and all of them, the -Proprio one too, get the clock,
+so that only the joint state differs between Proprio and Imu.
+
+HOBBY_LEG_SERVO / HOBBY_HEAD_SERVO (environment variables, read at import) pick the servos from SERVOS, so a torque sweep needs no code change.
+"""
+import os
+from copy import deepcopy
+
+import mujoco
+import torch
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab.tasks.velocity import mdp as velocity_mdp
+
+from mjlab_microduck.actuator.hobby_servo import HobbyServoActuatorCfg
+from mjlab_microduck.robot.microduck_constants import FULL_COLLISION
+from mjlab_microduck.robot.milli_constants import _ROBOT
+from mjlab_microduck.tasks.milli_velocity_env_cfg import HIP_YAW_STOP_WEIGHT, MilliRlCfg, STALL_FROM, STALL_WEIGHT, make_milli_velocity_env_cfg
+
+import json
+
+# Datasheet numbers at the voltage named; see docs/HOBBY_SERVOS.md for each source. Torque in N m (kg cm x 0.0981), speed in rad/s (60 deg / s-per-60-deg).
+SERVOS = {
+    "MG996R": dict(stall_nm=11.0 * 0.0981, noload_rads=1.0472 / 0.15, volts=6.0),     # 11 kg cm, 0.15 s/60 deg at 6 V (towerpro.com.tw)
+    "DS3218": dict(stall_nm=21.5 * 0.0981, noload_rads=1.0472 / 0.14, volts=6.8),     # 21.5 kg cm, 0.14 s/60 deg at 6.8 V (servodatabase.com; not the maker's page)
+    "MG90S": dict(stall_nm=2.2 * 0.0981, noload_rads=1.0472 / 0.08, volts=6.0),       # 2.2 kg cm (6.6 V), 0.08 s/60 deg (6 V) (towerpro.com.tw)
+}
+LEG_SERVO = os.environ.get("HOBBY_LEG_SERVO", "MG996R")
+HEAD_SERVO = os.environ.get("HOBBY_HEAD_SERVO", "MG90S")
+HEAD_JOINTS = ("head_yaw", "head_roll")             # nearly unloaded (duck-droids reports/checks.md: 0.00 N m static); neck and head pitch carry the head, so standard size
+BACKLASH_RAD = 0.026                                # +-1.5 deg at the output: an estimate for nylon/metal spur gears, to measure on the servos bought
+BACKLASH_ARMATURE = 2e-5                            # the play's own inertia and drag: small, but enough to keep the free hinge stable at 5 ms
+BACKLASH_DAMPING = 0.005
+HISTORY = 4                                         # steps (20 ms each) of actions and IMU the -Imu actor sees
+CLOCK_PERIOD = 0.6                                  # s a stride: swing 0.24 s, inside the recipe's air-time window for milli (0.14-0.33 s)
+CLOCK_SWING = 0.4
+CLOCK_WEIGHT = 1.0
+FADE_FROM, FADE_TO = 500, 2000                      # iterations of the 3000: first walk with the joints' help, then lose it; the last 1000 IMU only
+STEPS_PER_ITER = MilliRlCfg.num_steps_per_env
+_NOT_PASSIVE = r"^(?!passive_)"
+
+
+def _servo_of(joint):
+    return HEAD_SERVO if joint in HEAD_JOINTS else LEG_SERVO
+
+
+def make_hobby_robot_cfg(folder: str = "milli", backlash: float = BACKLASH_RAD) -> EntityCfg:
+    home = json.load(open(_ROBOT / folder / "home.json"))
+    joints = [j for s in home["servos"].values() for j in s["joints"]]
+
+    def spec_fn():
+        spec = mujoco.MjSpec.from_file(str(_ROBOT / folder / "milli.xml"))
+        if backlash > 0:
+            for name in joints:            # a second hinge on the same body, same axis and point: in series with the servo's
+                j = spec.joint(name)
+                j.parent.add_joint(name=f"passive_{name}_backlash", type=mujoco.mjtJoint.mjJNT_HINGE, axis=j.axis, pos=j.pos,
+                                   range=[-backlash, backlash], limited=mujoco.mjtLimited.mjLIMITED_TRUE,
+                                   armature=BACKLASH_ARMATURE, damping=BACKLASH_DAMPING)
+        return spec
+
+    groups = {}
+    for j in joints:
+        groups.setdefault(_servo_of(j), []).append(j)
+    return EntityCfg(
+        spec_fn=spec_fn,
+        init_state=EntityCfg.InitialStateCfg(pos=(0.0, 0.0, home["root_z"]), joint_pos={**home["joint_pos"], "passive_.*": 0.0}, joint_vel={".*": 0.0}),
+        collisions=(FULL_COLLISION,),
+        articulation=EntityArticulationInfoCfg(
+            actuators=tuple(
+                HobbyServoActuatorCfg(
+                    target_names_expr=tuple(f"^{j}$" for j in js),
+                    stall_nm=SERVOS[s]["stall_nm"], noload_rads=SERVOS[s]["noload_rads"], effort_limit=SERVOS[s]["stall_nm"] * 1.2,
+                    delay_min_lag=3, delay_max_lag=5,          # 15-25 ms, plus 0-15 ms waiting for the next 20 ms frame: 15-40 ms in all
+                )
+                for s, js in groups.items()
+            ),
+            soft_joint_pos_limit_factor=0.9,
+        ),
+    )
+
+
+def _clock(env):
+    return (env.episode_length_buf.float() * env.step_dt / CLOCK_PERIOD) % 1.0
+
+
+def hobby_clock(env):
+    a = 2 * torch.pi * _clock(env)
+    return torch.stack((torch.sin(a), torch.cos(a)), dim=1)
+
+
+def hobby_clock_contact(env, sensor_name: str, command_name: str = "twist"):
+    """Fraction of the feet doing what the clock says (in the air in their swing, down otherwise); told to stand, both down."""
+    ph = _clock(env)
+    x = torch.stack((ph / CLOCK_SWING, ((ph + 0.5) % 1.0) / CLOCK_SWING), dim=1)
+    cmd = env.command_manager.get_command(command_name)
+    moving = (torch.norm(cmd[:, :2], dim=1) + cmd[:, 2].abs()) > 0.05
+    swing = (x < 1.0) & moving[:, None]
+    down = env.scene[sensor_name].data.found > 0
+    return (down != swing).float().mean(dim=1)
+
+
+_stall = {}
+
+
+def hobby_near_stall(env):
+    """near_stall's penalty against the hobby servos' nominal stall torque, not the bus servos' in home.json."""
+    robot = env.scene["robot"]
+    if "t" not in _stall:
+        _stall["t"] = torch.tensor([SERVOS[_servo_of(j)]["stall_nm"] for j in robot.actuator_names], device=env.device)
+    load = robot.data.actuator_force.abs() / _stall["t"]
+    return (((load - STALL_FROM) / (1 - STALL_FROM)).clamp(0, 1) ** 2).sum(dim=1)
+
+
+_keep = {}
+
+
+def fade_keep(env):
+    """1 where this episode still shows the joints, 0 where it doesn't: redrawn at each robot's reset, at the moment's odds."""
+    it = env.common_step_counter / STEPS_PER_ITER
+    p_drop = min(max((it - FADE_FROM) / (FADE_TO - FADE_FROM), 0.0), 1.0)
+    k = _keep.get("k")
+    if k is None or k.shape[0] != env.num_envs:
+        k = _keep["k"] = torch.ones(env.num_envs, 1, device=env.device)
+    if _keep.get("at") != env.common_step_counter:     # once a step, so joint position and velocity share a mask
+        _keep["at"] = env.common_step_counter
+        fresh = env.episode_length_buf <= 1
+        k[fresh] = (torch.rand(int(fresh.sum()), 1, device=env.device) >= p_drop).float()
+    if p_drop >= 1.0:
+        k.zero_()
+    return k
+
+
+def _faded(fn):
+    def f(env, **kw):
+        return fn(env, **kw) * fade_keep(env)
+    f.__name__ = "faded_" + fn.__name__
+    return f
+
+
+def _scope_to_servos(cfg):
+    """With backlash hinges in the model: keep every joint term on the servo joints (the hinges ride their stops by design)."""
+    for name in ("dof_pos_limits", "hip_yaw_stops"):
+        r = cfg.rewards.get(name)
+        if r is None:
+            continue
+        ac = deepcopy(r.params.get("asset_cfg", SceneEntityCfg("robot", joint_names=(".*",))))
+        ac.joint_names = tuple(_NOT_PASSIVE + p.lstrip("^") for p in ac.joint_names)
+        r.params["asset_cfg"] = ac
+    pose = cfg.rewards.get("pose")
+    if pose is not None and "asset_cfg" in pose.params:
+        ac = deepcopy(pose.params["asset_cfg"])
+        ac.joint_names = tuple(p if "_backlash" in p else r"^(?!passive_.*_backlash)" + p.lstrip("^") for p in ac.joint_names)
+        pose.params["asset_cfg"] = ac
+    for grp in ("actor", "critic"):
+        for t in ("joint_pos", "joint_vel"):
+            term = cfg.observations[grp].terms.get(t)
+            if term is not None and "asset_cfg" not in term.params:
+                term.params["asset_cfg"] = SceneEntityCfg("robot", joint_names=(_NOT_PASSIVE + ".*",))
+
+
+def make_milli_hobby_env_cfg(play: bool = False, servos: str = "hobby", obs: str = "imu"):
+    """servos: 'hobby' or 'bus' (the hybrid's own). obs: 'imu', 'proprio', 'blind' or 'fade'."""
+    cfg = make_milli_velocity_env_cfg(play=play)
+    if servos == "hobby":
+        cfg.scene.entities = {"robot": make_hobby_robot_cfg()}
+        _scope_to_servos(cfg)
+        cfg.rewards["near_stall"] = RewardTermCfg(func=hobby_near_stall, weight=STALL_WEIGHT)
+        cfg.observations["actor"].terms.pop("foot_switch", None)      # the cheap duck has none
+    actor = cfg.observations["actor"].terms
+    for t in ("actions", "base_ang_vel", "projected_gravity"):      # the same history in every variant, so only joint state differs
+        if t in actor:
+            actor[t] = deepcopy(actor[t])
+            actor[t].history_length = HISTORY
+    if obs in ("imu", "blind"):
+        for t in ("joint_pos", "joint_vel", "foot_switch"):
+            actor.pop(t, None)
+    if obs == "fade":
+        for t in ("joint_pos", "joint_vel"):
+            actor[t] = deepcopy(actor[t])
+            actor[t].func = _faded(actor[t].func)
+    if obs == "blind":
+        for t in ("base_ang_vel", "projected_gravity", "raw_accelerometer"):
+            actor.pop(t, None)
+    for grp in ("actor", "critic"):
+        cfg.observations[grp].terms["gait_clock"] = ObservationTermCfg(func=hobby_clock)
+    cfg.rewards["clock_contact"] = RewardTermCfg(func=hobby_clock_contact, weight=CLOCK_WEIGHT, params={"sensor_name": "feet_ground_contact"})
+    return cfg
+
+
+def _rl(name):
+    r = deepcopy(MilliRlCfg)
+    r.experiment_name = r.run_name = name
+    return r
+
+
+# (task id suffix, servos, obs, log folder)
+HOBBY_TASKS = (
+    ("Imu", "bus", "imu", "milli_imu"),
+    ("Hobby-Proprio", "hobby", "proprio", "milli_hobby_proprio"),
