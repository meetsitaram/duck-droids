index 0000000..45eb35b
--- /dev/null
+++ b/src/mjlab_microduck/tasks/milli_ground_env_cfg.py
@@ -0,0 +1,166 @@
+"""milli's floor skills: getting back up, and the forward roll over its head. microduck's two recipes on milli's robot.
+
+What each recipe sets for microduck that would be wrong here, and what happens to it:
+- the robot: milli's model with a collision hull on every link above the shoes (make_rl_model.py --contact), no self-collision, its own DC motor model per servo;
+- every absolute height (trunk z of reset poses and rewards): by STAND_RATIO, milli's root at standing over microduck's, as milli's root sits higher in its body
+  as well as the robot being taller. Height stds by HEIGHT, the plain size ratio. Unmeasured for the low poses: rerun scripts/milli_sanity.py after a change;
+- microduck's knee folds past 1.3 rad and milli's stops at 1.05-1.10, so the sitting pose and the tucked pose here are milli's own. This may be what limits it;
+- the BAM friction randomization does nothing on these actuators: replaced, as in the walking task;
+- head centre-of-mass bodies, mass randomization on all links within 20 %, servo numbers within 30 %, as milli's masses and servos are estimates;
+- the roll's "top of the head" axis: milli's head frame is level at home, so straight up. It is a module-level value in mdp.py, so it is set when the environment starts.
+Kept, with why: reward weights and curriculum timing (dimensionless, or time in training); rate limits on the roll (5 and 7 rad/s: microduck's physics, unmeasured on milli,
+which is 1.2 x taller and so about 10 % slower); pushes.
+"""
+import re
+from copy import deepcopy
+from dataclasses import dataclass, fields
+
+from mjlab.envs import mdp as envs_mdp
+from mjlab.envs.mdp.actions.actions import JointPositionAction, JointPositionActionCfg
+from mjlab.managers.event_manager import EventTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+
+from mjlab_microduck.robot.milli_constants import MILLI_CONTACT_ROBOT_CFG, MILLI_CONTACT_STRONG_NECK_CFG, MILLI_DYNAMIXEL_CONTACT_ROBOT_CFG, MILLI_FEETECH_CONTACT_ROBOT_CFG
+from mjlab_microduck.tasks import mdp as microduck_mdp
+from mjlab_microduck.tasks.microduck_roulade_env_cfg import MicroduckRouladeRlCfg, make_microduck_roulade_env_cfg
+from mjlab_microduck.tasks.microduck_standup_env_cfg import MicroduckStandUpRlCfg, make_microduck_standup_env_cfg
+from mjlab_microduck.tasks.milli_velocity_env_cfg import HEIGHT, SERVO_DR
+
+STAND_Z = 0.172                                    # measured by scripts/milli_sanity.py: the root's height, standing
+STAND_RATIO = STAND_Z / 0.115                      # microduck's measured equilibrium
+HEAD_TOP = (0.0, 0.0, 1.0)
+SETTLE_S = 1.0                                     # a limp drop from the reset pose is still after about 0.7 s
+# a reset must clear the floor, or the overlap throws the robot up for free. Measured, with the hulls: lying on the head 0.124, on the back or side up to 0.108; sitting 0.132
+PRONE_Z = (0.126, 0.15)
+SIT_Z = (0.134, 0.15)
+FEETECH_STAND, FEETECH_PRONE, FEETECH_SIT = 0.170, (0.152, 0.175), (0.134, 0.15)   # (measured with the hulls)
+# the servo recipes: robot, root height standing, height over microduck's, lying and sitting reset heights, each measured as above
+RECIPES = {
+    "hybrid": dict(robot=MILLI_CONTACT_ROBOT_CFG, stand=STAND_Z, height=HEIGHT, prone=PRONE_Z, sit=SIT_Z),
+    "dynamixel": dict(robot=MILLI_DYNAMIXEL_CONTACT_ROBOT_CFG, stand=0.170, height=0.298 / 0.264, prone=(0.122, 0.145), sit=(0.134, 0.15)),
+    "feetech": dict(robot=MILLI_FEETECH_CONTACT_ROBOT_CFG, stand=FEETECH_STAND, height=0.377 / 0.264, prone=FEETECH_PRONE, sit=FEETECH_SIT),
+}
+# (joint index -> rad): 0-4 left leg, 5-8 neck and head, 9-13 right leg. Within milli's limits with the 0.9 soft factor
+SIT = {1: 0.0, 2: -0.45, 3: 0.95, 4: 0.0, 10: 0.0, 11: 0.45, 12: -0.95, 13: 0.0}
+# microduck's hip 1.15 puts milli's feet through its head (tools/checks.py overlap); the sim has no self-collision, so nothing else would stop that
+TUCK = {2: -0.8, 3: 0.95, 4: 1.05, 5: -1.0, 6: 1.0, 11: 0.8, 12: -0.95, 13: -1.05}
+_HEIGHT_KEY = re.compile(r"height|_z_(min|max)$")
+
+
+class SettleFirstAction(JointPositionAction):
+    """Servos hold the reset pose for the episode's first SETTLE_S, then the policy has them. A fall ends lying still; without this the policy swung its legs under itself on the way down."""
+
+    def __init__(self, cfg, env):
+        super().__init__(cfg, env)
+        self._env_ = env
+        self._steps = int(round(SETTLE_S / env.step_dt))
+        self._held = self._entity.data.default_joint_pos[:, self._target_ids].clone()
+
+    def process_actions(self, actions):
+        super().process_actions(actions)
+        age = self._env_.episode_length_buf
+        fresh = age == 0
+        self._held[fresh] = self._entity.data.joint_pos[fresh][:, self._target_ids]
+        hold = age < self._steps
+        self._processed_actions[hold] = self._held[hold]
+
+
+@dataclass(kw_only=True)
+class SettleFirstActionCfg(JointPositionActionCfg):
+    def build(self, env):
+        return SettleFirstAction(self, env)
+
+
+def _set_head_top(env, env_ids=None):
+    microduck_mdp._HEAD_TOP_AXIS = HEAD_TOP
+
+
+def _scale_heights(terms, stand=STAND_RATIO, height=HEIGHT):
+    for term in terms.values():
+        params = getattr(term, "params", None) or {}
+        for k, v in params.items():
+            if isinstance(v, float) and _HEIGHT_KEY.search(k):
+                params[k] = v * (height if k.endswith("_std") else stand)
+
+
+def _port(cfg, play, recipe="hybrid"):
+    r = RECIPES[recipe]
+    cfg.scene.entities = {"robot": r["robot"]}
+    cfg.sim.nconmax = 200                          # the recipe's budget, for its own tasks with close contact: self-collision now adds to the floor's
+    cfg.sim.njmax = 600
+    _scale_heights(cfg.rewards, r["stand"] / 0.115, r["height"])
+    _scale_heights(cfg.events, r["stand"] / 0.115, r["height"])
+    if "reset_base" in cfg.events:
+        cfg.events["reset_base"].params["pose_range"]["z"] = (0.0, 0.002)
+    if "randomize_head_com" in cfg.events:
+        cfg.events["randomize_head_com"].params["asset_cfg"].body_names = ("neck", "neck_pitch", "yaw_roll_motion", "jaw_soft")
+    if "randomize_mass_inertia" in cfg.events:
+        cfg.events["randomize_mass_inertia"].params["asset_cfg"].body_names = (".*",)
+        cfg.events["randomize_mass_inertia"].params["alpha_range"] = (-0.1, 0.1)
+    cfg.events.pop("expand_bam_friction_fields", None)
+    cfg.events.pop("randomize_joint_friction", None)
+    if not play:
+        dr = envs_mdp.dr
+        for name, fn in (("randomize_joint_friction", dr.joint_friction), ("randomize_joint_damping", dr.joint_damping)):
+            cfg.events[name] = EventTermCfg(
+                func=fn, mode="reset",
+                params={"asset_cfg": SceneEntityCfg("robot", joint_names=(".*",)), "operation": "scale", "ranges": SERVO_DR},
+            )
+        if "randomize_armature" in cfg.events:
+            cfg.events["randomize_armature"].params["ranges"] = SERVO_DR
+    return cfg
+
+
+def make_milli_standup_env_cfg(play: bool = False, recipe: str = "hybrid"):
+    cfg = _port(make_microduck_standup_env_cfg(play=play), play, recipe)
+    params = cfg.events["set_ground_state"].params
+    params["sitting_joint_overrides"] = SIT
+    params["prone_z_min"], params["prone_z_max"] = RECIPES[recipe]["prone"]
+    params["sitting_z_min"], params["sitting_z_max"] = RECIPES[recipe]["sit"]
+    old = cfg.actions["joint_pos"]
+    cfg.actions["joint_pos"] = SettleFirstActionCfg(**{f.name: getattr(old, f.name) for f in fields(old) if f.init})
+    cfg.episode_length_s += SETTLE_S
+    return cfg
+
+
+def make_milli_roulade_env_cfg(play: bool = False, strong_neck: bool = False, recipe: str = "hybrid"):
+    cfg = _port(make_microduck_roulade_env_cfg(play=play), play, recipe)
+    if strong_neck:
+        cfg.scene.entities = {"robot": MILLI_CONTACT_STRONG_NECK_CFG}
+    cfg.events["set_roulade_state"].params["tuck_overrides"] = TUCK
+    cfg.events["milli_head_top"] = EventTermCfg(func=_set_head_top, mode="startup")
+    cfg.episode_length_s = 5.5
+    return cfg
+
+
+MilliStandUpRlCfg = deepcopy(MicroduckStandUpRlCfg)
+MilliStandUpRlCfg.experiment_name = "milli_standup"
+MilliStandUpRlCfg.run_name = "milli_standup"
+MilliStandUpRlCfg.wandb_project = "milli"
+MilliStandUpRlCfg.max_iterations = 5000
+
