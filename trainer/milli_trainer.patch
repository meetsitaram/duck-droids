+"""milli (github.com/meetsitaram/open-micro-duck), on this trainer: the model is generated by milli's tools/make_rl_model.py into robot/milli/."""
+import json
+import os
+from pathlib import Path
+
+import mujoco
+from mjlab.actuator.dc_actuator import DcMotorActuatorCfg
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+from mjlab.utils.spec_config import CollisionCfg
+
+from mjlab_microduck.robot.microduck_constants import FULL_COLLISION
+
+_ROBOT = Path(os.path.dirname(__file__))
+
+
+def make_milli_robot_cfg(folder: str = "milli", collisions=(FULL_COLLISION,), stronger=None) -> EntityCfg:
+    """A generated model's folder: `milli`, or `milli_salvage` (the servos of a dismantled SO-101 pair). stronger: {joint: stall N m}, a what-if, with the gain scaled alike."""
+    home = json.load(open(_ROBOT / folder / "home.json"))
+    stronger = stronger or {}
+    groups = []
+    for s in home["servos"].values():
+        rest = [j for j in s["joints"] if j not in stronger]
+        if rest:
+            groups.append(dict(s, joints=rest))
+        groups += [dict(s, joints=[j], kp=s["kp"] * stronger[j] / s["peak_nm"], peak_nm=stronger[j]) for j in s["joints"] if j in stronger]
+    # Each servo model its own numbers (generated from milli's spec/actuators.json): position gain, stall torque, no-load speed.
+    # Joint damping, friction and armature are in milli.xml. The 15-30 ms delay is microduck's, kept as an estimate of a serial
+    # bus at 50 Hz: measure it on the real STS3215s.
+    return EntityCfg(
+        spec_fn=lambda: mujoco.MjSpec.from_file(str(_ROBOT / folder / "milli.xml")),
+        init_state=EntityCfg.InitialStateCfg(
+            pos=(0.0, 0.0, home["root_z"]),
+            joint_pos=home["joint_pos"],
+            joint_vel={".*": 0.0},
+        ),
+        collisions=collisions,
+        articulation=EntityArticulationInfoCfg(
+            actuators=tuple(
+                DcMotorActuatorCfg(
+                    target_names_expr=tuple(f"^{j}$" for j in s["joints"]),
+                    stiffness=s["kp"],
+                    damping=0.0,
+                    effort_limit=s["peak_nm"],
+                    saturation_effort=s["peak_nm"],
+                    velocity_limit=s["noload_rads"],
+                    delay_min_lag=3,
+                    delay_max_lag=6,
+                )
+                for s in groups
+            ),
+            soft_joint_pos_limit_factor=0.9,
+        ),
+    )
+
+
+MILLI_ROBOT_CFG = make_milli_robot_cfg()
+MILLI_SALVAGE_ROBOT_CFG = make_milli_robot_cfg("milli_salvage")
+# for tasks where the body meets the floor. Self-collision on, as without it a policy learned to rise by passing its feet through each other and its hips through the trunk:
+# contype 3, conaffinity 2 meets the floor (1) and the robot; a shoe's hull, contype 2, meets only the robot. Pairs whose hulls touch where the parts don't are excluded in milli.xml
+_CONTACT = (CollisionCfg(geom_names_expr=(".*_collision",), contype={r".*_foot_hull_collision$": 2, ".*_collision": 3}, conaffinity=2, condim=FULL_COLLISION.condim, priority=FULL_COLLISION.priority, friction=FULL_COLLISION.friction),)
+MILLI_CONTACT_ROBOT_CFG = make_milli_robot_cfg("milli_contact", _CONTACT)
+# what if the neck carried the body as well as microduck's does? Stall over the torque to hold the tucked body on the head: microduck 2.10 and 1.12, milli 1.23 and 0.40 (no such servos chosen yet)
+MILLI_DYNAMIXEL_ROBOT_CFG = make_milli_robot_cfg("milli_dynamixel")
+MILLI_DYNAMIXEL_CONTACT_ROBOT_CFG = make_milli_robot_cfg("milli_dynamixel_contact", _CONTACT)
+MILLI_FEETECH_ROBOT_CFG = make_milli_robot_cfg("milli_feetech")
+MILLI_FEETECH_CONTACT_ROBOT_CFG = make_milli_robot_cfg("milli_feetech_contact", _CONTACT)
+STRONG_NECK = {"neck_pitch": 1.57, "head_pitch": 1.45}
+MILLI_CONTACT_STRONG_NECK_CFG = make_milli_robot_cfg("milli_contact", _CONTACT, stronger=STRONG_NECK)
