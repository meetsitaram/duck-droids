+MilliRouladeRlCfg.experiment_name = "milli_roulade"
+MilliRouladeRlCfg.run_name = "milli_roulade"
+MilliRouladeRlCfg.wandb_project = "milli"
+MilliRouladeRlCfg.max_iterations = 5000
+
+MilliStandUpDynamixelRlCfg = deepcopy(MilliStandUpRlCfg)
+MilliStandUpDynamixelRlCfg.experiment_name = "milli_dynamixel_standup"
+MilliStandUpDynamixelRlCfg.run_name = "milli_dynamixel_standup"
+
+MilliRouladeDynamixelRlCfg = deepcopy(MilliRouladeRlCfg)
+MilliRouladeDynamixelRlCfg.experiment_name = "milli_dynamixel_roulade"
+MilliRouladeDynamixelRlCfg.run_name = "milli_dynamixel_roulade"
+
+MilliStandUpFeetechRlCfg = deepcopy(MilliStandUpRlCfg)
+MilliStandUpFeetechRlCfg.experiment_name = "milli_feetech_standup"
+MilliStandUpFeetechRlCfg.run_name = "milli_feetech_standup"
+
