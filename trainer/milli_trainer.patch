@@ -0,0 +1,34 @@
+"""Before a long run: load milli's task, reset it, and hold the home pose with zero actions. Numbers, not impressions."""
+import sys
+
+import numpy as np
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.registry import load_env_cfg
+
+cfg = load_env_cfg(sys.argv[1] if len(sys.argv) > 1 else "Mjlab-Velocity-Flat-Milli")
+cfg.scene.num_envs = 256
+for k in ("push_robot",):
+    cfg.events.pop(k, None)
+env = ManagerBasedRlEnv(cfg=cfg, device="cuda:0")
+env.reset()
+r = env.scene["robot"]
+site = r.find_sites(("left_foot", "right_foot"))[0]
+base = r.data.root_link_pos_w
+print("after reset: root z", round(base[:, 2].mean().item(), 4), "- env origin", round(env.scene.env_origins[:, 2].mean().item(), 4),
+      "sole z", round((r.data.site_pos_w[:, site, 2] - env.scene.env_origins[:, 2:3]).mean().item(), 4))
+print("mass", round(float(env.sim.mj_model.body("robot/trunk_base").subtreemass[0]) if False else 0, 3), "actuators", [type(a).__name__ for a in r.actuators],
+      "bodies[1]", env.sim.mj_model.body(1).name)
+a = torch.zeros((env.num_envs, env.action_manager.total_action_dim), device=env.device)
+done = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+for t in range(100):
+    env.step(a)
+    done |= env.termination_manager.terminated
+    if t in (0, 24, 49, 99):
+        print(f"t {0.02 * (t + 1):.2f} s: fell {done.float().mean().item() * 100:.0f} %, up z {r.data.projected_gravity_b[:, 2].mean().item():+.3f}, "
+              f"root z {(base[:, 2] - env.scene.env_origins[:, 2]).mean().item():.4f}, foot contact {env.scene['feet_ground_contact'].data.found.float().clamp(max=1).mean().item():.2f}")
+print("joint friction", np.round(env.sim.mj_model.dof_frictionloss[6:9], 3), "damping", np.round(env.sim.mj_model.dof_damping[6:9], 3))
+print("actor obs", env.observation_manager.group_obs_dim)
+print("events", list(cfg.events))
diff --git a/scripts/milli_skill_eval.py b/scripts/milli_skill_eval.py
new file mode 100644
index 0000000..d9625d8
--- /dev/null
+++ b/scripts/milli_skill_eval.py
@@ -0,0 +1,122 @@
+"""Can milli get back up, or roll over its head? Runs a floor task's checkpoint from each start and counts real successes, with the training's randomization on.
+
+  python scripts/milli_skill_eval.py standup|roulade [CHECKPOINT.pt] [--envs 256] [--seconds 8] [--trajdir DIR]
+
+Success at the end of the run: upright within 20 deg and the root within 15 % of standing height; for the roll, also a full forward turn on the way.
+A training reward cannot say this. --trajdir saves one successful robot from each start, for milli's tools/render_walk.py and tools/check_motion.py.
+"""
+import argparse
+import glob
+import json
+import math
+import os
+from dataclasses import asdict
+
+import numpy as np
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import RslRlVecEnvWrapper
+from mjlab.tasks.registry import load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab_microduck.tasks import mdp as microduck_mdp
+
+ap = argparse.ArgumentParser()
+ap.add_argument("skill", choices=("standup", "roulade"))
+ap.add_argument("ckpt", nargs="?")
+ap.add_argument("--envs", type=int, default=256)
+ap.add_argument("--seconds", type=float, default=8.0)
+ap.add_argument("--settle", type=float, default=1.5, help="seconds lying on the floor, servos holding, before the policy starts (stand-up only)")
+ap.add_argument("--trajdir")
+ap.add_argument("--out")
+ap.add_argument("--recipe", default="hybrid", help="the servo recipe: hybrid or dynamixel")
+a = ap.parse_args()
+SUFFIX, TAG = ("", "") if a.recipe == "hybrid" else ("-" + a.recipe.capitalize(), a.recipe + "_")
+TASK = {"standup": "Mjlab-StandUp-Flat-Milli", "roulade": "Mjlab-Roulade-Flat-Milli"}[a.skill] + SUFFIX
+NAME = f"milli_{TAG}{a.skill}"
+STARTS = {"standup": {"face down": dict(face_down_prob=1.0, face_up_prob=0.0, sitting_prob=0.0, standing_prob=0.0),
+                      "face up": dict(face_down_prob=0.0, face_up_prob=1.0, sitting_prob=0.0, standing_prob=0.0),
+                      "sitting": dict(face_down_prob=0.0, face_up_prob=0.0, sitting_prob=1.0, standing_prob=0.0)},
+          "roulade": {"standing": dict(standing_prob=1.0, midroll_prob=0.0)}}[a.skill]
+EVENT = {"standup": "set_ground_state", "roulade": "set_roulade_state"}[a.skill]
+STAND_Z = {"hybrid": 0.172}.get(a.recipe, 0.170)
+ck = a.ckpt
+if not ck:
+    runs = sorted(glob.glob(f"logs/rsl_rl/{NAME}/*"), key=os.path.getmtime)
+    ck = sorted(glob.glob(runs[-1] + "/model_*.pt"), key=lambda p: int(p.split("_")[-1][:-3]))[-1]
+print("checkpoint", ck)
+results = dict(checkpoint=ck, starts={})
+home = json.load(open("src/mjlab_microduck/robot/" + ("milli_contact" if a.recipe == "hybrid" else f"milli_{a.recipe}_contact") + "/home.json"))
+servo_of = {j: k for k, s in home["servos"].items() for j in s["joints"]}
+env = runner = policy = None
+for label, probs in STARTS.items():
+    cfg = load_env_cfg(TASK)
+    cfg.scene.num_envs = a.envs
+    cfg.events.pop("push_robot", None)
+    cfg.curriculum = {}
+    cfg.episode_length_s = 1000.0
+    cfg.events[EVENT].params.update(probs)
+    if env is None:
+        env = RslRlVecEnvWrapper(ManagerBasedRlEnv(cfg=cfg, device="cuda:0"), clip_actions=load_rl_cfg(TASK).clip_actions)
+        runner = load_runner_cls(TASK)(env, asdict(load_rl_cfg(TASK)), device="cuda:0")
+        runner.load(ck, map_location="cuda:0")
+        policy = runner.get_inference_policy(device="cuda:0")
+    base = env.unwrapped
+    base.event_manager.get_term_cfg(EVENT).params.update(probs)
+    robot = base.scene["robot"]
+    obs, _ = env.reset()
+    dt = base.step_dt
+    n = int(a.seconds / dt)
+    # a fall ends on the floor, and a reset's pose can start in the air: servos hold the pose until it lies still, and only then does the policy get it
+    if a.skill == "standup":
+        term = base.action_manager.get_term(base.action_manager.active_terms[0])
+        hold = (robot.data.joint_pos[:, term.target_ids] - term.offset) / term.scale
+        for _ in range(int(a.settle / dt)):
+            obs, _, _, _ = env.step(hold)
+    start_z = float(torch.median(robot.data.root_link_pos_w[:, 2] - base.scene.env_origins[:, 2]))
+    start_up = float(torch.median(-robot.data.projected_gravity_b[:, 2]))
+    start_speed = float(torch.median(torch.linalg.norm(robot.data.root_link_lin_vel_w, dim=1)))
+    alive = torch.ones(a.envs, dtype=torch.bool, device="cuda:0")
+    qs, tq, risen_at = [], [], torch.full((a.envs,), float("nan"), device="cuda:0")
+    best_turn = torch.zeros(a.envs, device="cuda:0")
+    for t in range(n):
+        with torch.no_grad():
+            act = policy(obs)
+        obs, _, _, _ = env.step(act)
+        alive &= ~base.termination_manager.terminated
+        up = -robot.data.projected_gravity_b[:, 2]
+        z = robot.data.root_link_pos_w[:, 2] - base.scene.env_origins[:, 2]
+        ok = (up > math.cos(math.radians(20))) & ((z - STAND_Z).abs() < 0.15 * STAND_Z)
+        risen_at = torch.where(torch.isnan(risen_at) & ok, torch.full_like(risen_at, t * dt), risen_at)
+        if a.skill == "roulade":
+            _, max_accum, _ = microduck_mdp._roulade_state(base)
+            best_turn = torch.maximum(best_turn, max_accum)
+        qs.append(np.concatenate([(robot.data.root_link_pos_w - base.scene.env_origins).cpu().numpy(), robot.data.root_link_quat_w.cpu().numpy(), robot.data.joint_pos.cpu().numpy()], axis=1))
+        tq.append(robot.data.actuator_force.cpu().numpy())
+    win = ok & alive
+    if a.skill == "roulade":
+        win &= best_turn >= 0.9 * 2 * math.pi
+    TQ = np.abs(np.array(tq))
+    names = list(robot.joint_names)
+    motors = list(robot.actuator_names)            # actuator_force's order, not joint_pos's
+    limit = np.array([home["servos"][servo_of[j]]["peak_nm"] for j in motors])
+    row = dict(success=float(win.float().mean()), alive=float(alive.float().mean()), median_time_s=float(np.nanmedian(risen_at[win].cpu().numpy())) if win.any() else None,
+               start=dict(z=start_z, up=start_up, speed=start_speed),
+               at_stall={j: float((TQ[:, :, i] > 0.98 * limit[i]).mean()) for i, j in enumerate(motors)})
+    if a.skill == "roulade":
+        row["best_turn_deg_median"] = float(torch.median(best_turn).item() * 180 / math.pi)
+    # is a joint limit what stops it? Time pressed against each joint's range (the training's 0.9 soft limit), to decide whether the design should change
+    Q = np.array(qs)[:, :, 7:]
+    lim = robot.data.soft_joint_pos_limits[0].cpu().numpy()
+    row["at_joint_limit"] = {j: float(((Q[:, :, i] < lim[i, 0] + 0.03) | (Q[:, :, i] > lim[i, 1] - 0.03)).mean()) for i, j in enumerate(names)}
+    results["starts"][label] = row
+    pressed = sorted(row["at_joint_limit"].items(), key=lambda kv: -kv[1])[:4]
+    print("           most at joint limit " + ", ".join(f"{k} {v * 100:.0f}%" for k, v in pressed))
+    worst = sorted(row["at_stall"].items(), key=lambda kv: -kv[1])[:3]
+    print(f"{label:10s} from z {start_z:.3f} up {start_up:+.2f} speed {start_speed:.3f}: success {row['success'] * 100:5.1f} %  time {row['median_time_s']}  " +(f"best turn {row.get('best_turn_deg_median', 0):.0f} deg  " if a.skill == "roulade" else "") + "most at stall " + ", ".join(f"{k} {v * 100:.0f}%" for k, v in worst))
+    if a.trajdir:
+        os.makedirs(a.trajdir, exist_ok=True)
+        i = int(torch.nonzero(win)[0]) if win.any() else 0
+        np.savez(os.path.join(a.trajdir, f"{a.skill}_{label.replace(' ', '_')}.npz"), q=np.array(qs)[:, i], names=np.array(names), dt=dt, won=bool(win.any()))
+if a.out:
+    json.dump(results, open(a.out, "w"), indent=1)
