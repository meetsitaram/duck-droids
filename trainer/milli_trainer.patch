+MilliRouladeRlCfg.max_iterations = 5000
+
+MilliStandUpDynamixelRlCfg = deepcopy(MilliStandUpRlCfg)
+MilliStandUpDynamixelRlCfg.experiment_name = "milli_dynamixel_standup"
+MilliStandUpDynamixelRlCfg.run_name = "milli_dynamixel_standup"
+
