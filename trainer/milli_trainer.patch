+"""Before a long run: load milli's task, reset it, and hold the home pose with zero actions. Numbers, not impressions."""
+import sys
+
+import numpy as np
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.registry import load_env_cfg
+
+cfg = load_env_cfg(sys.argv[1] if len(sys.argv) > 1 else "Mjlab-Velocity-Flat-Milli")
+cfg.scene.num_envs = 256
+for k in ("push_robot",):
+    cfg.events.pop(k, None)
+env = ManagerBasedRlEnv(cfg=cfg, device="cuda:0")
+env.reset()
+r = env.scene["robot"]
+site = r.find_sites(("left_foot", "right_foot"))[0]
+base = r.data.root_link_pos_w
+print("after reset: root z", round(base[:, 2].mean().item(), 4), "- env origin", round(env.scene.env_origins[:, 2].mean().item(), 4),
+      "sole z", round((r.data.site_pos_w[:, site, 2] - env.scene.env_origins[:, 2:3]).mean().item(), 4))
+print("mass", round(float(env.sim.mj_model.body("robot/trunk_base").subtreemass[0]) if False else 0, 3), "actuators", [type(a).__name__ for a in r.actuators],
+      "bodies[1]", env.sim.mj_model.body(1).name)
+a = torch.zeros((env.num_envs, env.action_manager.total_action_dim), device=env.device)
+done = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+for t in range(100):
+    env.step(a)
+    done |= env.termination_manager.terminated
+    if t in (0, 24, 49, 99):
+        print(f"t {0.02 * (t + 1):.2f} s: fell {done.float().mean().item() * 100:.0f} %, up z {r.data.projected_gravity_b[:, 2].mean().item():+.3f}, "
+              f"root z {(base[:, 2] - env.scene.env_origins[:, 2]).mean().item():.4f}, foot contact {env.scene['feet_ground_contact'].data.found.float().clamp(max=1).mean().item():.2f}")
+print("joint friction", np.round(env.sim.mj_model.dof_frictionloss[6:9], 3), "damping", np.round(env.sim.mj_model.dof_damping[6:9], 3))
+print("actor obs", env.observation_manager.group_obs_dim)
+print("events", list(cfg.events))
