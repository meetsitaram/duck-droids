@@ -0,0 +1,49 @@
+"""milli (github.com/meetsitaram/open-micro-duck), on this trainer: the model is generated by milli's tools/make_rl_model.py into robot/milli/."""
+import json
+import os
+from pathlib import Path
+
+import mujoco
+from mjlab.actuator.dc_actuator import DcMotorActuatorCfg
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+
+from mjlab_microduck.robot.microduck_constants import FULL_COLLISION
+
+_ROBOT = Path(os.path.dirname(__file__))
+
+
+def make_milli_robot_cfg(folder: str = "milli") -> EntityCfg:
+    """A generated model's folder: `milli`, or `milli_salvage` (the servos of a dismantled SO-101 pair)."""
+    home = json.load(open(_ROBOT / folder / "home.json"))
+    # Each servo model its own numbers (generated from milli's spec/actuators.json): position gain, stall torque, no-load speed.
+    # Joint damping, friction and armature are in milli.xml. The 15-30 ms delay is microduck's, kept as an estimate of a serial
+    # bus at 50 Hz: measure it on the real STS3215s.
+    return EntityCfg(
+        spec_fn=lambda: mujoco.MjSpec.from_file(str(_ROBOT / folder / "milli.xml")),
+        init_state=EntityCfg.InitialStateCfg(
+            pos=(0.0, 0.0, home["root_z"]),
+            joint_pos=home["joint_pos"],
+            joint_vel={".*": 0.0},
+        ),
+        collisions=(FULL_COLLISION,),
+        articulation=EntityArticulationInfoCfg(
+            actuators=tuple(
+                DcMotorActuatorCfg(
+                    target_names_expr=tuple(f"^{j}$" for j in s["joints"]),
+                    stiffness=s["kp"],
+                    damping=0.0,
+                    effort_limit=s["peak_nm"],
+                    saturation_effort=s["peak_nm"],
+                    velocity_limit=s["noload_rads"],
+                    delay_min_lag=3,
+                    delay_max_lag=6,
+                )
+                for s in home["servos"].values()
+            ),
+            soft_joint_pos_limit_factor=0.9,
+        ),
+    )
+
+
+MILLI_ROBOT_CFG = make_milli_robot_cfg()
+MILLI_SALVAGE_ROBOT_CFG = make_milli_robot_cfg("milli_salvage")
