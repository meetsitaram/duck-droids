index 0000000..6d3d0c5
--- /dev/null
+++ b/scripts/milli_ground_check.py
@@ -0,0 +1,31 @@
+"""Before a long run of a floor task: reset, hold zero actions, and print where each kind of spawn settles. python scripts/milli_ground_check.py TASK"""
+import sys
+
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.registry import load_env_cfg
+
+cfg = load_env_cfg(sys.argv[1])
+cfg.scene.num_envs = 256
+cfg.events.pop("push_robot", None)
+cfg.curriculum.pop("push_magnitude", None)
+env = ManagerBasedRlEnv(cfg=cfg, device="cuda:0")
+env.reset()
+r = env.scene["robot"]
+print("names", list(r.joint_names))
+a = torch.zeros((env.num_envs, env.action_manager.total_action_dim), device=env.device)
+z0 = r.data.root_link_pos_w[:, 2].clone()
+up0 = -r.data.projected_gravity_b[:, 2].clone()
+print("spawn z mean/min/max", [round(v, 3) for v in (z0.mean().item(), z0.min().item(), z0.max().item())])
+for t in range(100):
+    env.step(a)
+z = r.data.root_link_pos_w[:, 2]
+up = -r.data.projected_gravity_b[:, 2]
+for lab, m in (("spawned upright", up0 > 0.8), ("spawned tipped", up0.abs() <= 0.8), ("spawned inverted", up0 < -0.8)):
+    if m.any():
+        print(f"{lab}: {int(m.sum())} robots; after 2 s z {z[m].mean().item():.3f} (min {z[m].min().item():.3f}, max {z[m].max().item():.3f}), up {up[m].mean().item():+.2f}, moved {(z[m] - z0[m]).abs().mean().item() * 100:.1f} cm")
+print("max joint speed", round(r.data.joint_vel.abs().max().item(), 1), "nan", bool(torch.isnan(r.data.joint_pos).any()))
+print("rewards", list(cfg.rewards)[:40])
+print("events", list(cfg.events))
diff --git a/scripts/milli_limits.py b/scripts/milli_limits.py
new file mode 100644
index 0000000..29b2ebe
--- /dev/null
+++ b/scripts/milli_limits.py
@@ -0,0 +1,49 @@
+"""Is a joint resting on its stop? python scripts/milli_limits.py CHECKPOINT [TASK]: each leg joint's angle, torque, and how often it's at its limit, in stance and in swing, told 0.3 m/s."""
+import sys
+import numpy as np, torch
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import RslRlVecEnvWrapper
+from mjlab.tasks.registry import load_env_cfg, load_rl_cfg, load_runner_cls
+from dataclasses import asdict
+
+TASK = sys.argv[2] if len(sys.argv) > 2 else 'Mjlab-Velocity-Flat-Milli-Big'
+ck = sys.argv[1]
+cfg = load_env_cfg(TASK)
+cfg.scene.num_envs = 32
+cfg.events.pop('push_robot', None)
+w = RslRlVecEnvWrapper(ManagerBasedRlEnv(cfg=cfg, device="cuda:0"), clip_actions=load_rl_cfg(TASK).clip_actions)
+env = w.unwrapped
+rl = load_rl_cfg(TASK)
+runner = load_runner_cls(TASK)(w, asdict(rl), device="cuda:0")
+runner.load(ck, map_location="cuda:0")
+pol = runner.get_inference_policy(device="cuda:0")
+robot = env.scene['robot']
+obs = w.get_observations()
+env.command_manager.get_term('twist').cfg.ranges.lin_vel_x = (0.3, 0.3)
+env.command_manager.get_term('twist').cfg.ranges.lin_vel_y = (0.0, 0.0)
+env.command_manager.get_term('twist').cfg.ranges.ang_vel_z = (0.0, 0.0)
+env.command_manager.get_term('twist').cfg.rel_standing_envs = 0.0
+names = list(robot.joint_names)
+an = list(robot.actuator_names)
+LEG = ['left_hip_pitch', 'left_knee', 'left_ankle']
+ids = [names.index(j) for j in LEG]
+aid = [an.index(j) for j in LEG]
+Q, T, C = [], [], []
+with torch.no_grad():
+    for i in range(400):
+        obs, *_ = w.step(pol(obs))
+        if i > 100:
+            Q.append(robot.data.joint_pos[:, ids].cpu().numpy())
+            T.append(robot.data.actuator_force[:, aid].cpu().numpy())
+            C.append((env.scene['feet_ground_contact'].data.found[:, 0] > 0).cpu().numpy())
+Q, T, C = np.array(Q), np.array(T), np.array(C)
+lim = robot.data.joint_pos_limits[0, ids].cpu().numpy()
+soft = robot.data.soft_joint_pos_limits[0, ids].cpu().numpy() if hasattr(robot.data, 'soft_joint_pos_limits') else lim
+print('foot on the floor', round(C.mean() * 100), '% of the time')
+for k, j in enumerate(LEG):
+    q, t = Q[..., k], T[..., k]
+    hi = lim[k, 1]
+    for tag, m in (('stance', C), ('swing', ~C)):
+        print(f"{j:15s} {tag:6s} angle mean {q[m].mean():+.2f} min {q[m].min():+.2f} max {q[m].max():+.2f}  torque mean {t[m].mean():+7.1f} RMS {np.sqrt((t[m] ** 2).mean()):6.1f}  within 3 cm-rad of its limits {((q[m] > hi - 0.03) | (q[m] < lim[k, 0] + 0.03)).mean() * 100:4.0f} %")
+    print(f"   hard limits {lim[k].round(2)} soft {np.round(soft[k], 2)}")
