@@ -0,0 +1,134 @@
+"""milli's walking task: microduck's velocity recipe, on milli's robot, plus the foot switches as policy inputs.
+
+What the recipe sets for microduck that would be wrong here, each found by reading the loaded config:
+- the reset's height is an offset from the root's default: microduck's 12-13 cm dropped milli from 12 cm at every reset;
+- friction randomization acts only through microduck's BAM servo model (a no-op on these plain actuators): replaced;
+- milli's servo numbers are scaled or copied, not measured: friction, damping and armature get wide ranges;
+- its head commands (to +-1.1 rad at the neck, about its own 20 deg HOME) pass milli's neck limit, which is 0.15 rad one way;
+- lengths and times of its gait (foot lift, air time, pushes, CoM offsets) are scaled by HEIGHT, milli's height over microduck's;
+- its mass randomization covered the trunk within 5 %; milli's masses are estimates, so all links within 20 %.
+- its yaw reward is exp(-error^2 / 0.5): a policy twisting at +-3 rad/s scores about 0 whatever it does, so nothing teaches it to stop. Trained on that, milli learned to pivot
+  over the stance foot on both hip yaws at 1.8 Hz, even told to stand still, and never learned to turn or go straight. So a quadratic yaw error too, and a tighter hip yaw pose.
+- nothing in it stops a servo holding stall: given that yaw error, the policy pressed both hip yaws on their stops at full torque, all the time, which is steady in sim and burns a real
+  servo. So a penalty near stall on every servo, and a heavy one for the hip yaws' stops (the recipe's -1 per radian cost -0.1 there, against -0.9 for twisting).
+Kept as they are, and why: speed commands (+-0.4 m/s: milli's longer leg against its slower servos); foot friction 0.7-1.3 (both TPU);
+IMU and encoder noise (similar parts, unmeasured); the reward weights and the curricula's timing (dimensionless, or time in training).
+"""
+import json
+from copy import deepcopy
+from pathlib import Path
+
+import torch
+from mjlab.envs import mdp as envs_mdp
+from mjlab.managers.event_manager import EventTermCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab.tasks.velocity import mdp as velocity_mdp
+
+from mjlab_microduck.robot import milli_constants as robot_constants
+from mjlab_microduck.robot.milli_constants import MILLI_DYNAMIXEL_ROBOT_CFG, MILLI_FEETECH_ROBOT_CFG, MILLI_ROBOT_CFG, MILLI_SALVAGE_ROBOT_CFG
+from mjlab_microduck.tasks.microduck_velocity_env_cfg import MicroduckRlCfg, make_microduck_velocity_env_cfg
+
+SERVO_DR = (0.7, 1.3)
+YAW_ERROR_WEIGHT = -0.1                            # at the +-3 rad/s it learned without this: -0.9, against 2.0 for tracking speed
+HIP_YAW_STD = 0.15                                 # the recipe's 0.3 allowed the swing
+STALL_FROM = 0.7                                   # of stall torque: below this a servo is working, not stalling
+STALL_WEIGHT = -0.5                                # two servos held at stall: -1.0, against 2.0 for tracking speed
+HIP_YAW_STOP_WEIGHT = -10.0                        # both pressed on their stops, 0.05 rad past the soft limit: -1.0
+ROBOTS = Path(robot_constants.__file__).parent
+HEIGHT = 0.321 / 0.264                             # milli's over microduck's
+TIME = HEIGHT ** 0.5                               # the same walk's time scale
+# the servo recipes: (robot, its generated model's folder, its height over microduck's)
+RECIPES = {"hybrid": (MILLI_ROBOT_CFG, "milli", HEIGHT), "dynamixel": (MILLI_DYNAMIXEL_ROBOT_CFG, "milli_dynamixel", 0.298 / 0.264), "feetech": (MILLI_FEETECH_ROBOT_CFG, "milli_feetech", 0.377 / 0.264)}
+# head commands, by the curriculum's stage: (neck_pitch, head_pitch, head_yaw, head_roll), within milli's limits (neck -1.6..0.15) and
+# short of where its head meets its body (head pitch -1.07 at the neck's zero)
+_STAGE = (0.05, 0.17, 0.39, 0.72, 1.0)
+
+
+def yaw_rate_error(env, command_name: str = "twist"):
+    """Squared error, so it has a gradient however wrong the yaw rate is."""
+    cmd = env.command_manager.get_command(command_name)
+    return (cmd[:, 2] - env.scene["robot"].data.root_link_ang_vel_b[:, 2]) ** 2
+
+
+_peaks = {}
+
+
+def near_stall(env, folder: str = "milli"):
+    """Each servo's load above STALL_FROM of its stall torque, from 0 to 1 at stall, squared and summed. A servo can pass through stall, but can't stay there."""
+    robot = env.scene["robot"]
+    if folder not in _peaks:
+        home = json.load(open(ROBOTS / folder / "home.json"))
+        peak = {j: s["peak_nm"] for s in home["servos"].values() for j in s["joints"]}
+        _peaks[folder] = torch.tensor([peak[j] for j in robot.actuator_names], device=env.device)  # actuator_force's order, not joint_pos's
+    load = robot.data.actuator_force.abs() / _peaks[folder]
+    return (((load - STALL_FROM) / (1 - STALL_FROM)).clamp(0, 1) ** 2).sum(dim=1)
+
+
+def make_milli_velocity_env_cfg(play: bool = False, salvage: bool = False, recipe: str = "hybrid"):
+    robot, folder, HEIGHT = RECIPES[recipe]
+    TIME = HEIGHT ** 0.5
+    cfg = make_microduck_velocity_env_cfg(play=play)
+    cfg.scene.entities = {"robot": MILLI_SALVAGE_ROBOT_CFG if salvage else robot}
+    cfg.events["reset_base"].params["pose_range"]["z"] = (0.0, 0.002)
+    cfg.events["push_robot"].params["velocity_range"] = {"x": (-0.3 * TIME, 0.3 * TIME), "y": (-0.3 * TIME, 0.3 * TIME)} if "push_robot" in cfg.events else None
+    air = cfg.rewards["air_time"].params
+    air["threshold_min"], air["threshold_max"] = 0.125 * TIME, 0.3 * TIME
+    for r_ in ("foot_clearance", "foot_swing_height"):
+        cfg.rewards[r_].params["target_height"] = 0.02 * HEIGHT
+    cfg.rewards["body_pose_tracking"].params["nominal_height"] = 0.095 * HEIGHT
+    if "base_com" in cfg.events:
+        cfg.events["base_com"].params["ranges"] = {0: (-0.03, 0.03), 1: (-0.03, 0.03), 2: (-0.036, 0.036)}
+    if "randomize_head_com" in cfg.events:                 # (the recipe also listed a hip link here)
+        cfg.events["randomize_head_com"].params["asset_cfg"].body_names = ("neck", "neck_pitch", "yaw_roll_motion", "jaw_soft")
+    if "randomize_mass_inertia" in cfg.events:
+        cfg.events["randomize_mass_inertia"].params["asset_cfg"].body_names = (".*",)
+        cfg.events["randomize_mass_inertia"].params["alpha_range"] = (-0.1, 0.1)
+    head = lambda f: ((-0.8 * f, min(0.12, 0.8 * f)), (-0.8 * f, 0.8 * f), (-1.4 * f, 1.4 * f), (-0.31 * f, 0.31 * f))
+    cfg.commands["head_pose"].ranges = head(_STAGE[0])
+    steps = (0, 12000, 24000, 36000, 48000)
+    cfg.curriculum["head_pose_range"].params["range_stages"] = [dict(step=st, ranges=head(f)) for st, f in zip(steps, _STAGE)]
+    cfg.rewards["yaw_rate_error"] = RewardTermCfg(func=yaw_rate_error, weight=YAW_ERROR_WEIGHT)
+    cfg.rewards["near_stall"] = RewardTermCfg(func=near_stall, weight=STALL_WEIGHT, params={"folder": "milli_salvage" if salvage else folder})
+    cfg.rewards["hip_yaw_stops"] = RewardTermCfg(func=velocity_mdp.joint_pos_limits, weight=HIP_YAW_STOP_WEIGHT, params={"asset_cfg": SceneEntityCfg("robot", joint_names=(r".*hip_yaw.*",))})
+    for k in ("std_walking", "std_running"):
+        stds = dict(cfg.rewards["pose"].params[k])
+        stds[r".*hip_yaw.*"] = HIP_YAW_STD
+        cfg.rewards["pose"].params[k] = stds
+    # a microswitch in each shoe (milli's spec): two booleans the real robot reads on GPIO, as Open Duck Mini's policy has
+    cfg.observations["actor"].terms["foot_switch"] = ObservationTermCfg(
+        func=velocity_mdp.foot_contact,
+        params={"sensor_name": "feet_ground_contact"},
+    )
+    cfg.events.pop("expand_bam_friction_fields", None)
+    cfg.events.pop("randomize_joint_friction", None)
+    if not play:
+        dr = envs_mdp.dr
+        for name, fn in (("randomize_joint_friction", dr.joint_friction), ("randomize_joint_damping", dr.joint_damping)):
+            cfg.events[name] = EventTermCfg(
+                func=fn, mode="reset",
+                params={"asset_cfg": SceneEntityCfg("robot", joint_names=(".*",)), "operation": "scale", "ranges": SERVO_DR},
+            )
+        if "randomize_armature" in cfg.events:
+            cfg.events["randomize_armature"].params["ranges"] = SERVO_DR
+    return cfg
+
+
+MilliRlCfg = deepcopy(MicroduckRlCfg)
+MilliRlCfg.experiment_name = "milli"
+MilliRlCfg.run_name = "milli"
+MilliRlCfg.wandb_project = "milli"
+MilliRlCfg.max_iterations = 3000
+
+MilliDynamixelRlCfg = deepcopy(MilliRlCfg)
+MilliDynamixelRlCfg.experiment_name = "milli_dynamixel"
+MilliDynamixelRlCfg.run_name = "milli_dynamixel"
+
+MilliFeetechRlCfg = deepcopy(MilliRlCfg)
+MilliFeetechRlCfg.experiment_name = "milli_feetech"
+MilliFeetechRlCfg.run_name = "milli_feetech"
+
+MilliSalvageRlCfg = deepcopy(MilliRlCfg)
+MilliSalvageRlCfg.experiment_name = "milli_salvage"
+MilliSalvageRlCfg.run_name = "milli_salvage"
