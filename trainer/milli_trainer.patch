+MilliRouladeDynamixelRlCfg.experiment_name = "milli_dynamixel_roulade"
+MilliRouladeDynamixelRlCfg.run_name = "milli_dynamixel_roulade"
+
+MilliStandUpFeetechRlCfg = deepcopy(MilliStandUpRlCfg)
+MilliStandUpFeetechRlCfg.experiment_name = "milli_feetech_standup"
+MilliStandUpFeetechRlCfg.run_name = "milli_feetech_standup"
+
+MilliRouladeFeetechRlCfg = deepcopy(MilliRouladeRlCfg)
+MilliRouladeFeetechRlCfg.experiment_name = "milli_feetech_roulade"
+MilliRouladeFeetechRlCfg.run_name = "milli_feetech_roulade"
+
+MilliStandUpHd1910RlCfg = deepcopy(MilliStandUpRlCfg)
+MilliStandUpHd1910RlCfg.experiment_name = "milli_hd1910_standup"
+MilliStandUpHd1910RlCfg.run_name = "milli_hd1910_standup"
+
