+"""Everything the loaded milli task inherited: python scripts/milli_audit.py. Read it against milli, line by line."""
+import dataclasses
+import numbers
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.tasks.registry import load_env_cfg, load_rl_cfg
+
+c = load_env_cfg("Mjlab-Velocity-Flat-Milli")
+p = load_env_cfg("Mjlab-Velocity-Flat-Milli", play=True) if False else None
+
+
+def show(v):
+    if isinstance(v, (numbers.Number, str, bool)) or v is None:
+        return repr(round(v, 5) if isinstance(v, float) else v)
+    if isinstance(v, dict):
+        return "{" + ", ".join(f"{k}: {show(x)}" for k, x in v.items()) + "}"
+    if isinstance(v, (list, tuple)):
+        return "(" + ", ".join(show(x) for x in v) + ")"
+    if dataclasses.is_dataclass(v):
+        keep = {f.name: getattr(v, f.name) for f in dataclasses.fields(v) if getattr(v, f.name) not in (None, (), [], {}) and f.name not in ("class_type",)}
+        return type(v).__name__ + show(keep)
+    return getattr(v, "__name__", type(v).__name__)
+
+
+print("== sim", "decimation", c.decimation, "episode_s", c.episode_length_s, "timestep", c.sim.mujoco.timestep, "iterations", c.sim.mujoco.iterations, "integrator", c.sim.mujoco.integrator)
+print("   nconmax", c.sim.nconmax, "njmax", c.sim.njmax, "terrain", show(getattr(c.scene.terrain, "terrain_type", None)))
+for group, g in c.observations.items():
+    print(f"== observations {group}")
+    for n, t in g.terms.items():
+        print(f"  {n:26s} {getattr(t.func, '__name__', t.func)} {show(t.params)} noise={show(t.noise)} delay={t.delay_min_lag},{t.delay_max_lag} hist={t.history_length} scale={t.scale}")
+print("== actions")
+for n, a in c.actions.items():
+    print(" ", n, show(a))
+print("== commands")
+for n, a in c.commands.items():
+    print(" ", n, show(a))
+print("== events")
+for n, e in c.events.items():
+    print(f"  {n:28s} {e.mode:9s} {getattr(e.func, '__name__', e.func)} {show(e.params)} every={e.interval_range_s}")
+print("== rewards")
+for n, r in c.rewards.items():
+    print(f"  {n:28s} w={r.weight:<8} {getattr(r.func, '__name__', r.func)} {show(r.params)}")
+print("== terminations")
+for n, r in c.terminations.items():
+    print(f"  {n:24s} {getattr(r.func, '__name__', r.func)} {show(r.params)}")
+print("== curriculum")
+for n, r in c.curriculum.items():
+    print(f"  {n:24s} {getattr(r.func, '__name__', r.func)} {show(r.params)}")
+print("== sensors")
+for s in c.scene.sensors:
+    print(" ", show(s))
diff --git a/scripts/milli_eval.py b/scripts/milli_eval.py
new file mode 100644
index 0000000..88a52bb
--- /dev/null
+++ b/scripts/milli_eval.py
@@ -0,0 +1,179 @@
+"""Can milli walk on these servos? Runs a checkpoint through fixed commands, with the training's randomization on, and reports.
+
+  python scripts/milli_eval.py [CHECKPOINT.pt] [--envs 512] [--video OUT.mp4]
+
+For each command: robots still up at the end, the speed they really reached, and each servo's load against its limits. The video
+replays one robot in plain MuJoCo.
+"""
+import argparse
+import glob
+import json
+import os
+import sys
+from dataclasses import asdict
+
+import mujoco
+import numpy as np
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import RslRlVecEnvWrapper
+from mjlab.tasks.registry import load_env_cfg, load_rl_cfg, load_runner_cls
+
+TESTS = [("stand", 0, 0, 0), ("forward 0.1", 0.1, 0, 0), ("forward 0.2", 0.2, 0, 0), ("forward 0.3", 0.3, 0, 0), ("forward 0.4", 0.4, 0, 0),
+         ("backward 0.2", -0.2, 0, 0), ("sideways 0.2", 0, 0.2, 0), ("turn 1.0", 0, 0, 1.0)]
+SECONDS = 8.0
+SKIP = 2.0                                         # seconds to settle before measuring
+
+ap = argparse.ArgumentParser()
+ap.add_argument("ckpt", nargs="?")
+ap.add_argument("--envs", type=int, default=512)
+ap.add_argument("--video")
+ap.add_argument("--out", default="milli_eval.json")
+ap.add_argument("--salvage", action="store_true", help="the model on a dismantled SO-101 pair's servos")
+ap.add_argument("--recipe", default="hybrid", help="the servo recipe: hybrid or dynamixel")
+ap.add_argument("--only", help="run this one test, e.g. 'forward 0.3', and record its walk")
+ap.add_argument("--seconds", type=float, default=SECONDS)
+ap.add_argument("--traj", help="save the recorded walk (a robot still up at the end), for milli's tools/render_walk.py")
+ap.add_argument("--nudge", action="append", default=[], help="a real force on the trunk during the run: 'seconds,forward N,left N,duration', in the body's frame; repeatable")
+ap.add_argument("--straightest", action="store_true", help="record the robot that turned least: for a picture, not a measure of the policy")
+a = ap.parse_args()
+WALK = a.only or "forward 0.3"
+TESTS = [t for t in TESTS if not a.only or t[0] == a.only]
+NUDGES = [tuple(float(v) for v in n.split(",")) for n in a.nudge]
+TASK = "Mjlab-Velocity-Flat-Milli-Salvage" if a.salvage else "Mjlab-Velocity-Flat-Milli" + ("" if a.recipe == "hybrid" else "-" + a.recipe.capitalize())
+NAME = "milli_salvage" if a.salvage else "milli" + ("" if a.recipe == "hybrid" else "_" + a.recipe)
+ck = a.ckpt
+if not ck:
+    runs = sorted(glob.glob(f"logs/rsl_rl/{NAME}/*"), key=os.path.getmtime)
+    cands = sorted(glob.glob(runs[-1] + "/model_*.pt"), key=lambda p: int(p.split("_")[-1][:-3]))
+    ck = cands[-1]
+print("checkpoint", ck)
+
+cfg = load_env_cfg(TASK)
+cfg.scene.num_envs = a.envs
+cfg.events.pop("push_robot", None)
+cfg.curriculum = {}
+cfg.episode_length_s = 1000.0
+tw = cfg.commands["twist"]
+tw.resampling_time_range = (1000.0, 1000.0)
+tw.heading_command = False
+tw.ranges.heading = None
+tw.rel_standing_envs = 0.0
+tw.rel_forward_envs = 0.0
+tw.rel_turn_in_place_envs = 0.0
+for n in ("head_pose", "body_pose"):
+    cfg.commands[n].ranges = tuple((0.0, 0.0) for _ in cfg.commands[n].ranges)
+env = RslRlVecEnvWrapper(ManagerBasedRlEnv(cfg=cfg, device="cuda:0"), clip_actions=load_rl_cfg(TASK).clip_actions)
+rl = load_rl_cfg(TASK)
+runner = load_runner_cls(TASK)(env, asdict(rl), device="cuda:0")
+runner.load(ck, map_location="cuda:0")
+policy = runner.get_inference_policy(device="cuda:0")
+base = env.unwrapped
+robot = base.scene["robot"]
+twist = base.command_manager.get_term("twist")
+names = list(robot.joint_names)
+ids = [names.index(n) for n in names]
+home = json.load(open(f"src/mjlab_microduck/robot/{NAME}/home.json"))
+servo_of = {j: k for k, s in home["servos"].items() for j in s["joints"]}
+lim = {j: home["servos"][servo_of[j]] for j in names}
+results, video_q = {}, None
+dt = base.step_dt
+for label, vx, vy, wz in TESTS:
+    obs, _ = env.reset()
+    n = int(a.seconds / dt)
+    skip = int(SKIP / dt)
+    up = torch.ones(a.envs, dtype=torch.bool, device="cuda:0")
+    vel, tq, qd, qs, xy, fs = [], [], [], [], [], []
+    trunk = int(robot.indexing.body_ids[robot.find_bodies("trunk_base")[0][0]])
+    for t in range(n):
+        twist.vel_command_b[:, 0], twist.vel_command_b[:, 1], twist.vel_command_b[:, 2] = vx, vy, wz
+        with torch.no_grad():
+            act = policy(obs)
+        F = torch.zeros((a.envs, 3), device="cuda:0")
+        for t0, fx, fy, d_ in NUDGES:
+            if t0 <= t * dt < t0 + d_:
+                q = robot.data.root_link_quat_w
+                yaw = torch.atan2(2 * (q[:, 0] * q[:, 3] + q[:, 1] * q[:, 2]), 1 - 2 * (q[:, 2] ** 2 + q[:, 3] ** 2))
+                F[:, 0] = fx * torch.cos(yaw) - fy * torch.sin(yaw)
+                F[:, 1] = fx * torch.sin(yaw) + fy * torch.cos(yaw)
+        if NUDGES:
+            base.sim.data.xfrc_applied[:, trunk, :3] = F
+        fs.append(F.cpu().numpy())
+        obs, _, dones, _ = env.step(act)
+        up &= ~base.termination_manager.terminated
+        if t >= skip:
+            xy.append((robot.data.root_link_pos_w[:, :2] - base.scene.env_origins[:, :2]).clone())
+            v = robot.data.root_link_lin_vel_b
+            w = robot.data.root_link_ang_vel_b
+            vel.append(torch.stack([v[:, 0], v[:, 1], w[:, 2]], 1))
+            tq.append(robot.data.actuator_force.clone())
+            qd.append(robot.data.joint_vel.clone())
+        if label == WALK:
+            qs.append(np.concatenate([(robot.data.root_link_pos_w - base.scene.env_origins).cpu().numpy(),
+                                      robot.data.root_link_quat_w.cpu().numpy(), robot.data.joint_pos.cpu().numpy()], axis=1))
+    m = up.cpu().numpy()
+    V = torch.stack(vel).cpu().numpy()
+    TQ = torch.stack(tq).cpu().numpy()
+    QD = torch.stack(qd).cpu().numpy()
+    got = V[:, m].mean(axis=(0, 1)) if m.any() else np.zeros(3)
+    a_names = list(robot.actuator_names) if hasattr(robot, "actuator_names") else names
+    # per robot, as an average over robots hides circles: left and right ones cancel, and body-frame speed counts walking in a circle as speed
+    P = torch.stack(xy).cpu().numpy()
+    T = (len(P) - 1) * dt
+    net = np.linalg.norm(P[-1] - P[0], axis=1)[m] / T if m.any() else np.zeros(1)
+    turn = np.abs(V[:, m, 2].mean(axis=0)) if m.any() else np.zeros(1)
+    row = dict(survived=float(m.mean()), vx=float(got[0]), vy=float(got[1]), wz=float(got[2]), net_speed=float(np.median(net)), abs_turn=float(np.median(turn)),
+               abs_turn_p90=float(np.percentile(turn, 90)), joints={})
+    for i, jn in enumerate(a_names):
+        d = TQ[:, m, i] if m.any() else TQ[:, :, i]
+        w = QD[:, m, names.index(jn)] if m.any() else QD[:, :, names.index(jn)]
+        s = lim[jn]
+        row["joints"][jn] = dict(rms=float(np.sqrt((d ** 2).mean())), p99=float(np.percentile(np.abs(d), 99)), at_limit=float((np.abs(d) > 0.98 * s["peak_nm"]).mean()),
+                                 peak_nm=s["peak_nm"], servo=servo_of[jn], speed_rms=float(np.sqrt((w ** 2).mean())), speed_p99=float(np.percentile(np.abs(w), 99)),
+                                 noload_rads=s["noload_rads"])
+    results[label] = row
+    print(f"{label:14s} up {m.mean() * 100:5.1f} %  got vx {got[0]:+.3f} vy {got[1]:+.3f} wz {got[2]:+.2f}  per robot: start-to-end speed {row['net_speed']:.3f} m/s, |turn| median {row['abs_turn']:.2f}, 90th pct {row['abs_turn_p90']:.2f} rad/s")
+    if label == WALK:
+        keep = int(np.where(m)[0][np.argmin(turn)]) if a.straightest and m.any() else int(np.argmax(m))
+        video_q = np.array(qs)[:, keep]
+        video_f = np.array(fs)[:, keep]
+        print(f"recorded robot {keep}: turning {V[:, keep, 2].mean():+.2f} rad/s" + (f", the straightest of {int(m.sum())}" if a.straightest else ""))
+if a.traj:
+    np.savez(a.traj, q=video_q, force=video_f, names=np.array(names), dt=dt, root_z=home["root_z"])
+    print(a.traj)
+if a.only:
+    json.dump(dict(checkpoint=ck, tests=results), open(a.out, "w"), indent=1)
+    sys.exit(0)
+print(f"\n{'joint':18s}{'servo':15s}{'stall':>6s}" + "".join(f"{t[0][:11]:>13s}" for t in TESTS[3:5]) + "   (RMS / 99th pct / % at stall)")
+for jn in [j for j in a_names if j.startswith("left") or "neck" in j or "head_pitch" in j]:
+    L = lim[jn]
+    cols = "".join(f"{results[t[0]]['joints'][jn]['rms']:5.2f}/{results[t[0]]['joints'][jn]['p99']:4.2f}/{results[t[0]]['joints'][jn]['at_limit'] * 100:2.0f}".rjust(13) for t in TESTS[3:5])
+    J = results["forward 0.3"]["joints"][jn]
+    print(f"{jn:18s}{servo_of[jn]:15s}{L['peak_nm']:6.2f}{cols}   speed at 0.3: RMS {J['speed_rms']:.2f}, 99th pct {J['speed_p99']:.2f}, no-load {J['noload_rads']:.1f} rad/s")
+json.dump(dict(checkpoint=ck, tests=results), open(a.out, "w"), indent=1)
+if a.video and video_q is not None:
+    import imageio.v2 as imageio
+    x = open(f"src/mjlab_microduck/robot/{NAME}/milli.xml").read().replace(
+        "<worldbody>", '<visual><global offwidth="1280" offheight="720"/></visual><asset><texture type="2d" name="g" builtin="checker" rgb1=".88 .88 .88" rgb2=".95 .95 .95" width="256" height="256"/>'
+        '<material name="g" texture="g" texrepeat="40 40"/></asset><worldbody><light directional="true" dir="-0.5 -0.3 -1" diffuse=".5 .5 .5"/><geom type="plane" size="5 5 .1" material="g"/>', 1)
+    p = f"src/mjlab_microduck/robot/{NAME}/_view.xml"
+    open(p, "w").write(x)
+    M = mujoco.MjModel.from_xml_path(p)
+    D = mujoco.MjData(M)
+    os.remove(p)
+    order = [M.joint(n).qposadr[0] for n in names]
+    r = mujoco.Renderer(M, 720, 1280)
+    cam = mujoco.MjvCamera()
+    cam.azimuth, cam.elevation, cam.distance = 130, -10, 0.85
+    F = []
+    for i in range(0, len(video_q)):
+        D.qpos[:7] = video_q[i, :7]
+        D.qpos[order] = video_q[i, 7:]
+        mujoco.mj_forward(M, D)
+        cam.lookat[:] = [D.qpos[0], D.qpos[1], 0.14]
+        r.update_scene(D, cam)
+        F.append(r.render().copy())
+    imageio.mimsave(a.video, F, fps=int(round(1 / dt)), codec="libx264", quality=7, macro_block_size=1)
+    print(a.video)
